# Backend Environment Configuration
# Copy this file to .env and fill in your configuration

# MongoDB connection string
# Default: mongodb://localhost:27017/octofit_db
MONGODB_URI=mongodb://localhost:27017/octofit_db

# API Port
# Default: 8000
PORT=8000

# Optional: GitHub Codespaces name used to build public API base URL
# Example URL: https://<codespace-name>-8000.app.github.dev
CODESPACE_NAME=

# Node Environment
NODE_ENV=development
